{
  "name": "agent-nuvira",
  "version": "3.3.1",
  "description": "Agent-Nuvira: Multi-agent AI coding CLI — plan, write, review, test, and publish code with local models (Ollama) or cloud APIs (Groq, NVIDIA NIM, Google Gemini, OpenRouter)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-nuvira": "dist/index.js",
    "buff": "dist/index.js",
    "nuvira": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/resources','dist/resources',{recursive:true})\" && node scripts/fix-esm-extensions.mjs && node -e \"if(process.platform!=='win32')require('child_process').execSync('chmod +x dist/index.js')\" && node scripts/build-dashboard.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:all": "npm test && npm run test:dashboard",
    "test:dashboard": "node scripts/check-dashboard-deps.mjs && cd src/web-dashboard && npx vitest run",
    "test:watch": "vitest",
    "docs:commands": "node scripts/generate-commands-surface.mjs",
    "docs:commands:check": "node scripts/generate-commands-surface.mjs --check",
    "test:coverage": "vitest run --coverage",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "build:sdk": "cd src/agent-sdk && npx tsc",
    "prepare": "node scripts/prepare-install.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "verify:commands": "node scripts/verify-commands.mjs",
    "demo:cli": "node scripts/generate-cli-demo.mjs --only highlight",
    "demo:cli:all": "node scripts/generate-cli-demo.mjs --only all"
  },
  "keywords": [
    "ai",
    "cli",
    "llm",
    "code-generation",
    "multi-agent",
    "ollama",
    "groq",
    "gemini",
    "nim",
    "openrouter",
    "inference",
    "devops",
    "coding-agent",
    "code-review",
    "automation",
    "developer-tools",
    "typescript",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Dheeraj Sharma <imdheeraj@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdheerajKube/agent-nuvira.git"
  },
  "bugs": {
    "url": "https://github.com/imdheerajKube/agent-nuvira/issues"
  },
  "homepage": "https://github.com/imdheerajKube/agent-nuvira#readme",
  "engines": {
    "node": ">=18.18.0"
  },
  "files": [
    "dist/",
    "src/web-dashboard/public/",
    "README.md",
    "LICENSE",
    ".agents/skills/"
  ],
  "dependencies": {
    "@microsoft/recognizers-text-date-time": "^1.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@vscode/ripgrep": "^1.18.0",
    "baileys": "7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "execa": "^8.0.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "ink": "^5.2.1",
    "inquirer": "^9.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "ora": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "typescript": "^5.3.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@faiss-node/native": "^0.1.11",
    "@huggingface/transformers": "^4.2.0",
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/ws": "^8.18.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.7.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
