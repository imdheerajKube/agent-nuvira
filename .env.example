[TEMPLATE]
# ═══════════════════════════════════════════════════════════════════════════════
#  Environment Variables — Agent-Nuvira
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in your API keys:
#    cp .env.example .env
#    # Then edit .env with your keys
#
#  Without any keys, only local models (Ollama) are available.
#  Each provider below is optional — configure only the ones you use.
#
#  NOTE: Legacy BUFF_* env vars are still supported for backward compatibility.
#        NUVIRA_* takes priority when both are set.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Groq ────────────────────────────────────────────────────────────────────
# Fast LPU cloud inference. Free tier: ~30 req/min, 14400 req/day.
# Get your key: https://console.groq.com
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── NVIDIA NIM ──────────────────────────────────────────────────────────────
# NVIDIA NIM cloud or self-hosted inference. Free tier: 1000 req/day.
# Get your key: https://build.nvidia.com
# NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google Gemini ───────────────────────────────────────────────────────────
# Google Gemini API — strong reasoning, large context. Free tier: 60 req/min.
# Get your key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OpenRouter ──────────────────────────────────────────────────────────────
# Unified API — access 200+ models. $1 free trial credits.
# Get your key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Local Inference (Ollama) ────────────────────────────────────────────────
# When running with `docker compose --profile ollama up`, set OLLAMA_HOST
# to point to the companion container.
# OLLAMA_HOST=http://ollama:11434

# ═══════════════════════════════════════════════════════════════════════════════
#  Gateway / Platform Transports
# ═══════════════════════════════════════════════════════════════════════════════
#  Configure the messaging platforms the gateway connects to.
#  Set at least one to enable multi-channel messaging.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather. Two-way: receive messages + send replies.
# NUVIRA_TELEGRAM_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Discord ─────────────────────────────────────────────────────────────────
# Bot token for two-way messaging, OR webhook URL for send-only.
# NUVIRA_DISCORD_BOT_TOKEN=MTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NUVIRA_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ─── Slack ───────────────────────────────────────────────────────────────────
# Bot token for two-way, OR webhook URL for send-only.
# NUVIRA_SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NUVIRA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/Txxx/Bxxx/xxx
# NUVIRA_SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── WhatsApp (Baileys bridge — personal account) ────────────────────────────
# Pair your personal WhatsApp via QR code. Session stored in ~/.nuvira/whatsapp/session/
# Run: nuvira whatsapp pair
# NUVIRA_WHATSAPP_SESSION_DIR=~/.nuvira/whatsapp/session

# ─── WhatsApp (Cloud API — business account) ─────────────────────────────────
# Meta Business API token + phone ID for official WhatsApp integration.
# NUVIRA_WHATSAPP_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NUVIRA_WHATSAPP_PHONE_ID=123456789012345

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# SMTP relay for email channel. Works with Gmail, SendGrid, etc.
# NUVIRA_SMTP_HOST=smtp.gmail.com:587
# NUVIRA_SMTP_USER=your-email@gmail.com
# NUVIRA_SMTP_PASS=your-app-password
# NUVIRA_SMTP_FROM=your-email@gmail.com

# ─── Signal ──────────────────────────────────────────────────────────────────
# Signal account via signal-cli-rest-api.
# NUVIRA_SIGNAL_ACCOUNT=+15551234567

# ─── Matrix ──────────────────────────────────────────────────────────────────
# Matrix homeserver for two-way messaging.
# NUVIRA_MATRIX_HOMESERVER=https://matrix.org
# NUVIRA_MATRIX_ACCESS_TOKEN=syt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── DingTalk ────────────────────────────────────────────────────────────────
# DingTalk robot webhook (send-only).
# NUVIRA_DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx

# ─── Feishu/Lark ────────────────────────────────────────────────────────────
# Feishu bot webhook (send-only).
# NUVIRA_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# ─── WeCom (WeChat Work) ────────────────────────────────────────────────────
# WeCom group bot webhook (send-only).
# NUVIRA_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ─── Mattermost ──────────────────────────────────────────────────────────────
# Mattermost incoming webhook (send-only).
# NUVIRA_MATTERMOST_WEBHOOK_URL=https://mm.example.com/hooks/xxx

# ─── Generic Webhook ─────────────────────────────────────────────────────────
# POST JSON payloads to any URL (send-only).
# NUVIRA_WEBHOOK_URL=https://your-service.com/webhook

# ─── BlueBubbles (iMessage) ─────────────────────────────────────────────────
# BlueBubbles server for iMessage integration.
# NUVIRA_BLUEBUBBLES_URL=http://127.0.0.1:1234
# NUVIRA_BLUEBUBBLES_PASSWORD=your-password

# ─── ntfy (Push Notifications) ──────────────────────────────────────────────
# Push notifications via ntfy.sh or self-hosted instance.
# NUVIRA_NTFY_TOPIC=my-topic
# NUVIRA_NTFY_URL=https://ntfy.sh

# ─── Microsoft Teams ─────────────────────────────────────────────────────────
# Teams incoming webhook (send-only).
# NUVIRA_TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxx

# ─── Google Chat ─────────────────────────────────────────────────────────────
# Google Chat space webhook (send-only).
# NUVIRA_GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/xxx/messages

# ─── Weixin (iLink) ─────────────────────────────────────────────────────────
# Weixin iLink bot token (send-only).
# NUVIRA_WEIXIN_TOKEN=your-bot-token

# ═══════════════════════════════════════════════════════════════════════════════
#  Gateway Access Control
# ═══════════════════════════════════════════════════════════════════════════════

# Platform:channelId pairs allowed to trigger the agent (e.g. "whatsapp:919876543210").
# NUVIRA_GATEWAY_ALLOW_IDS=whatsapp:919876543210,telegram:123456789

# Per-platform user allowlists (overrides global).
# NUVIRA_GATEWAY_ALLOWED_USERS_TELEGRAM=123456789,987654321
# NUVIRA_GATEWAY_ALLOWED_GROUPS_SLACK=C0123ABCDEF

# Require @mention in groups (default: false).
# NUVIRA_GATEWAY_REQUIRE_MENTION=true

# Fully disable a platform's pipeline triggers.
# NUVIRA_GATEWAY_DISABLED_PLATFORMS=dingtalk,feishu

# ═══════════════════════════════════════════════════════════════════════════════
#  Dashboard
# ═══════════════════════════════════════════════════════════════════════════════

# Dashboard server port and host.
# NUVIRA_DASHBOARD_PORT=3030
# NUVIRA_DASHBOARD_HOST=127.0.0.1

# Admin credentials (zero-config alternative to the interactive setup).
# NUVIRA_DASHBOARD_ADMIN_USER=admin
# NUVIRA_DASHBOARD_ADMIN_PASSWORD=your-secure-password
# NUVIRA_DASHBOARD_ADMIN_ROLE=admin

# ═══════════════════════════════════════════════════════════════════════════════
#  Advanced / Internal
# ═══════════════════════════════════════════════════════════════════════════════

# Override the config directory (default: ~/.nuvira or ~/.buff).
# NUVIRA_CONFIG_DIR=/path/to/custom/config

# Override the memory directory (default: ~/.nuvira/memory).
# NUVIRA_MEMORY_DIR=/path/to/custom/memory

# Override the env file path (default: ~/.nuvira/.env).
# NUVIRA_ENV_FILE=/path/to/custom/.env

# Vector search backend (auto | faiss-native | faiss-ivf | json).
# NUVIRA_VECTOR_BACKEND=auto

# Skills registry URL (local dir or GitHub raw URL).
# NUVIRA_SKILLS_REGISTRY=/path/to/local/registry

# Act as a different user for RBAC testing.
# NUVIRA_ACT_AS=admin

# Enable structured JSON logging.
# NUVIRA_LOG_JSON=true

# Disable log redaction (DEBUGGING ONLY — exposes API keys in logs!).
# NUVIRA_NO_REDACT=true

# Verbose debug output.
# NUVIRA_DEBUG=true

# Telemetry action tag for IDE integration.
# NUVIRA_TELEMETRY_ACTION=ide-chat

# Image generation API URL (Pollinations.ai default, or local SD/ComfyUI).
# NUVIRA_IMAGE_API_URL=http://localhost:7860

# Piper TTS model for voice synthesis.
# NUVIRA_PIPER_MODEL=en_US-lessac-medium

# SearXNG instance URL for web search.
# NUVIRA_SEARXNG_URL=http://localhost:8888

# Artifact storage directory.
# NUVIRA_ARTIFACTS_DIR=/path/to/artifacts

# Allow private network URLs in web research (security risk).
# NUVIRA_WEB_ALLOW_PRIVATE=1

# Git credentials for repo operations.
# NUVIRA_GIT_USERNAME=your-username
# NUVIRA_GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Active model state file path.
# NUVIRA_ACTIVE_MODEL_PATH=/path/to/active-model.json
