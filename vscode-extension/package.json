{
  "name": "agent-nuvira-vscode",
  "displayName": "%nuvira.displayName%",
  "description": "%nuvira.description%",
  "version": "1.56.1",
  "publisher": "dheerajsharma",
  "license": "MIT",
  "icon": "icon.png",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/imdheerajKube/agent-nuvira-documentation.git"
  },
  "bugs": {
    "url": "https://github.com/imdheerajKube/agent-nuvira-documentation/issues"
  },
  "homepage": "https://github.com/imdheerajKube/agent-nuvira-documentation/blob/main/docs/user-manual.md",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%nuvira.capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "%nuvira.capabilities.virtualWorkspaces%"
    }
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "code-generation",
    "multi-agent",
    "llm",
    "ollama",
    "groq",
    "gemini",
    "code-review",
    "agent",
    "openrouter",
    "nvidia-nim"
  ],
  "activationEvents": [
    "onCommand:agent-nuvira.executeGoal",
    "onCommand:agent-nuvira.quickFix",
    "onCommand:agent-nuvira.reviewFile",
    "onCommand:agent-nuvira.explainCode",
    "onCommand:agent-nuvira.generateTest",
    "onCommand:agent-nuvira.showPanel",
    "onCommand:agent-nuvira.openChat",
    "onCommand:agent-nuvira.runWorkflow",
    "onCommand:agent-nuvira.switchModel",
    "onCommand:agent-nuvira.modelHealth",
    "onCommand:agent-nuvira.showQuota",
    "onView:agent-nuvira.agentProgress",
    "onView:agent-nuvira.chatPanel"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./tsconfig.json && node ./scripts/copy-assets.mjs",
    "watch": "tsc -watch -p ./tsconfig.json",
    "lint": "tsc --noEmit -p ./tsconfig.json",
    "l10n:check": "node ./scripts/l10n-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run compile && tsc -p tsconfig.e2e.json && node ./out/test/e2e/runTest.js",
    "package": "npx @vscode/vsce package --out agent-nuvira-vscode.vsix",
    "publish": "npx @vscode/vsce publish",
    "publish:openvsx": "npx ovsx publish agent-nuvira-vscode.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "agent-nuvira.executeGoal",
        "title": "%nuvira.cmd.executeGoal.title%",
        "shortTitle": "%nuvira.cmd.executeGoal.shortTitle%",
        "description": "%nuvira.cmd.executeGoal.description%"
      },
      {
        "command": "agent-nuvira.quickFix",
        "title": "%nuvira.cmd.quickFix.title%",
        "shortTitle": "%nuvira.cmd.quickFix.shortTitle%",
        "description": "%nuvira.cmd.quickFix.description%"
      },
      {
        "command": "agent-nuvira.reviewFile",
        "title": "%nuvira.cmd.reviewFile.title%",
        "shortTitle": "%nuvira.cmd.reviewFile.shortTitle%",
        "description": "%nuvira.cmd.reviewFile.description%"
      },
      {
        "command": "agent-nuvira.explainCode",
        "title": "%nuvira.cmd.explainCode.title%",
        "shortTitle": "%nuvira.cmd.explainCode.shortTitle%",
        "description": "%nuvira.cmd.explainCode.description%"
      },
      {
        "command": "agent-nuvira.generateTest",
        "title": "%nuvira.cmd.generateTest.title%",
        "shortTitle": "%nuvira.cmd.generateTest.shortTitle%",
        "description": "%nuvira.cmd.generateTest.description%"
      },
      {
        "command": "agent-nuvira.openChat",
        "title": "%nuvira.cmd.openChat.title%",
        "shortTitle": "%nuvira.cmd.openChat.shortTitle%",
        "description": "%nuvira.cmd.openChat.description%"
      },
      {
        "command": "agent-nuvira.showPanel",
        "title": "%nuvira.cmd.showPanel.title%",
        "shortTitle": "%nuvira.cmd.showPanel.shortTitle%",
        "description": "%nuvira.cmd.showPanel.description%"
      },
      {
        "command": "agent-nuvira.runWorkflow",
        "title": "%nuvira.cmd.runWorkflow.title%",
        "shortTitle": "%nuvira.cmd.runWorkflow.shortTitle%",
        "description": "%nuvira.cmd.runWorkflow.description%"
      },
      {
        "command": "agent-nuvira.acceptChanges",
        "title": "%nuvira.cmd.acceptChanges.title%",
        "shortTitle": "%nuvira.cmd.acceptChanges.shortTitle%",
        "description": "%nuvira.cmd.acceptChanges.description%"
      },
      {
        "command": "agent-nuvira.rejectChanges",
        "title": "%nuvira.cmd.rejectChanges.title%",
        "shortTitle": "%nuvira.cmd.rejectChanges.shortTitle%",
        "description": "%nuvira.cmd.rejectChanges.description%"
      },
      {
        "command": "agent-nuvira.switchModel",
        "title": "%nuvira.cmd.switchModel.title%",
        "shortTitle": "%nuvira.cmd.switchModel.shortTitle%",
        "description": "%nuvira.cmd.switchModel.description%"
      },
      {
        "command": "agent-nuvira.modelHealth",
        "title": "%nuvira.cmd.modelHealth.title%",
        "shortTitle": "%nuvira.cmd.modelHealth.shortTitle%",
        "description": "%nuvira.cmd.modelHealth.description%"
      },
      {
        "command": "agent-nuvira.showQuota",
        "title": "%nuvira.cmd.showQuota.title%",
        "shortTitle": "%nuvira.cmd.showQuota.shortTitle%",
        "description": "%nuvira.cmd.showQuota.description%"
      }
    ],
    "keybindings": [
      {
        "command": "agent-nuvira.quickFix",
        "key": "ctrl+shift+a q",
        "mac": "cmd+shift+a q",
        "when": "editorTextFocus"
      },
      {
        "command": "agent-nuvira.executeGoal",
        "key": "ctrl+shift+a e",
        "mac": "cmd+shift+a e",
        "when": "editorTextFocus"
      },
      {
        "command": "agent-nuvira.reviewFile",
        "key": "ctrl+shift+a r",
        "mac": "cmd+shift+a r",
        "when": "editorTextFocus"
      },
      {
        "command": "agent-nuvira.openChat",
        "key": "ctrl+shift+a c",
        "mac": "cmd+shift+a c",
        "when": "editorTextFocus"
      },
      {
        "command": "agent-nuvira.showPanel",
        "key": "ctrl+shift+a p",
        "mac": "cmd+shift+a p",
        "when": "editorTextFocus"
      },
      {
        "command": "agent-nuvira.acceptChanges",
        "key": "ctrl+shift+a a",
        "mac": "cmd+shift+a a",
        "when": "agent-nuvira.hasChanges"
      },
      {
        "command": "agent-nuvira.rejectChanges",
        "key": "ctrl+shift+a x",
        "mac": "cmd+shift+a x",
        "when": "agent-nuvira.hasChanges"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "agent-nuvira.reviewFile",
          "when": "resourceExtname =~ /\\.(ts|js|tsx|jsx|py|go|rs|java|rb|php|vue|svelte)$/",
          "group": "agent-nuvira@1"
        },
        {
          "command": "agent-nuvira.quickFix",
          "when": "resourceExtname =~ /\\.(ts|js|tsx|jsx|py|go|rs|java|rb|php|vue|svelte)$/",
          "group": "agent-nuvira@2"
        },
        {
          "command": "agent-nuvira.generateTest",
          "when": "resourceExtname =~ /\\.(ts|js|tsx|jsx|py|go|rs|java|rb|php)$/",
          "group": "agent-nuvira@3"
        }
      ],
      "editor/context": [
        {
          "command": "agent-nuvira.explainCode",
          "when": "editorHasSelection",
          "group": "agent-nuvira@1"
        },
        {
          "command": "agent-nuvira.quickFix",
          "when": "editorTextFocus",
          "group": "agent-nuvira@2"
        },
        {
          "command": "agent-nuvira.generateTest",
          "when": "editorTextFocus",
          "group": "agent-nuvira@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "agent-nuvira.reviewFile",
          "when": "resourceExtname =~ /\\.(ts|js|tsx|jsx|py|go|rs|java|rb|php)$/",
          "group": "agent-nuvira@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-nuvira",
          "title": "%nuvira.container.title%",
          "icon": "resources/agent-nuvira.svg"
        }
      ]
    },
    "views": {
      "agent-nuvira": [
        {
          "type": "webview",
          "id": "agent-nuvira.agentProgress",
          "name": "%nuvira.view.agentProgress%"
        },
        {
          "type": "webview",
          "id": "agent-nuvira.chatPanel",
          "name": "%nuvira.view.chatPanel%"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "agentNuviraGetStarted",
        "title": "%nuvira.walkthrough.title%",
        "description": "%nuvira.walkthrough.description%",
        "steps": [
          {
            "id": "installCli",
            "title": "%nuvira.walkthrough.installCli.title%",
            "description": "%nuvira.walkthrough.installCli.description%",
            "completionEvents": [
              "onCommand:agent-nuvira.modelHealth"
            ]
          },
          {
            "id": "configureProvider",
            "title": "%nuvira.walkthrough.configureProvider.title%",
            "description": "%nuvira.walkthrough.configureProvider.description%",
            "completionEvents": [
              "onCommand:agent-nuvira.switchModel"
            ]
          },
          {
            "id": "runGoal",
            "title": "%nuvira.walkthrough.runGoal.title%",
            "description": "%nuvira.walkthrough.runGoal.description%",
            "completionEvents": [
              "onCommand:agent-nuvira.executeGoal"
            ]
          },
          {
            "id": "openChat",
            "title": "%nuvira.walkthrough.openChat.title%",
            "description": "%nuvira.walkthrough.openChat.description%",
            "completionEvents": [
              "onCommand:agent-nuvira.openChat"
            ]
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "agent-nuvira_reviewFile",
        "displayName": "%nuvira.tool.reviewFile.displayName%",
        "toolReferenceName": "reviewFileWithAgentNuvira",
        "userDescription": "%nuvira.tool.reviewFile.userDescription%",
        "modelDescription": "Review a source file for bugs, security issues, and best-practice violations using Agent-Nuvira's specialized reviewer agent. Use when the user asks for a review of a specific file or the active file.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Absolute path of the file to review. Defaults to the active editor's file."
            }
          },
          "required": []
        },
        "tags": [
          "agent-nuvira"
        ]
      },
      {
        "name": "agent-nuvira_explainSelection",
        "displayName": "%nuvira.tool.explain.displayName%",
        "toolReferenceName": "explainWithAgentNuvira",
        "userDescription": "%nuvira.tool.explain.userDescription%",
        "modelDescription": "Produce a detailed explanation of a code snippet using Agent-Nuvira. Use when the user asks what a piece of code does or how it works. Defaults to the current editor selection.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "The code to explain. Defaults to the active editor's current selection."
            }
          },
          "required": []
        },
        "tags": [
          "agent-nuvira"
        ]
      },
      {
        "name": "agent-nuvira_executeGoal",
        "displayName": "%nuvira.tool.execute.displayName%",
        "toolReferenceName": "executeGoalWithAgentNuvira",
        "userDescription": "%nuvira.tool.execute.userDescription%",
        "modelDescription": "Run Agent-Nuvira's multi-agent pipeline to accomplish a coding goal (plan, write, review, test). Use for substantial tasks that require editing multiple files or running commands.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "goal": {
              "type": "string",
              "description": "The goal to accomplish, in plain language."
            }
          },
          "required": [
            "goal"
          ]
        },
        "tags": [
          "agent-nuvira"
        ]
      }
    ],
    "configuration": {
      "title": "%nuvira.config.title%",
      "properties": {
        "agent-nuvira.cliPath": {
          "type": "string",
          "default": "agent-nuvira",
          "description": "%nuvira.config.cliPath%"
        },
        "agent-nuvira.defaultProvider": {
          "type": "string",
          "default": "",
          "description": "%nuvira.config.defaultProvider%"
        },
        "agent-nuvira.defaultModel": {
          "type": "string",
          "default": "",
          "description": "%nuvira.config.defaultModel%"
        },
        "agent-nuvira.autoApplyChanges": {
          "type": "boolean",
          "default": false,
          "description": "%nuvira.config.autoApplyChanges%"
        },
        "agent-nuvira.maxTokens": {
          "type": "integer",
          "default": 4096,
          "description": "%nuvira.config.maxTokens%"
        },
        "agent-nuvira.showProgressPanel": {
          "type": "boolean",
          "default": true,
          "description": "%nuvira.config.showProgressPanel%"
        },
        "agent-nuvira.useAutoRouting": {
          "type": "boolean",
          "default": false,
          "description": "%nuvira.config.useAutoRouting%"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.0.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
